{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capabilities granted to the main window: HTTP to local daemon, shell sidecar/process management, dialog, store, self-update.",
  "windows": ["main", "settings"],
  "permissions": [
    "core:default",
    "core:window:default",
    "core:window:allow-start-dragging",
    "core:event:default",
    "core:path:default",
    "core:webview:default",
    "shell:allow-open",
    "dialog:default",
    "store:default",
    "opener:default",
    "updater:default",
    "process:allow-restart"
  ]
}
