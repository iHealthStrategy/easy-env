{
  "name": "easy-env",
  "version": "0.1.0-alpha",
  "description": "AI-native environment provisioning and behavior verification toolkit.",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "smoke": "npm run smoke --workspace easy-env-mcp",
    "mcp": "npm run start --workspace easy-env-mcp",
    "daemon": "npm run daemon --workspace easy-env-mcp",
    "app:install": "npm --prefix app install",
    "app:dev": "npm --prefix app run tauri:dev",
    "app:build": "npm --prefix app run tauri:build",
    "clean": "rm -rf packages/*/dist packages/*/node_modules node_modules"
  }
}
